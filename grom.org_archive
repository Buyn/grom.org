#+begin_src clojure :no-expand t :mkdirp yes
(ns giggin.core
  (:require [reagent.core :as r]
            [giggin.components.gigs :refer [gigs]]
            [giggin.state :refer [gigs-cursor] :as state ]
            [giggin.components.header :refer [header]]
            [giggin.components.orders :refer [orders]]
            [giggin.api :as api]
            [giggin.fb.init :refer [firebase-init]]
            [giggin.components.footer :refer [footer]]))

(defonce app-state state/app-state)

(defn app
  []
  [:div.container
   [header]
   [gigs app-state]
   [orders app-state]
   [footer]])

(defn ^:export main
  []
  (api/fetch-gigs (gigs-cursor app-state))
  (r/render
    [app]
    (.getElementById js/document "app"))
  (firebase-init)
  )


#+end_src


