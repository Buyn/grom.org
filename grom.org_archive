(defn strip-components [hiccup]
  (cond
    ;; 1️⃣ Reagent-компонент
    (and (vector? hiccup) (fn? (first hiccup)))
      (into [:__component__]
            (map strip-components (rest hiccup)))
    ;; 2️⃣ hiccup-вектор
    (vector? hiccup)
      (mapv strip-components hiccup)
    ;; 3️⃣ props map (event handlers и т.п.)
    (map? hiccup)
      (into {}
            (for [[k v] hiccup]
              [k (if (fn? v)
                  :__fn__
                  (strip-components v))]))
    ;; 4️⃣ всё остальное
    :else hiccup))
***** 02
