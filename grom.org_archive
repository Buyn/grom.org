(defn t [k]
  (get-in dict [@lang k]))

;; (defn toggle-lang []
;;   (swap! lang {:en :uk :uk :en}))
(defn toggle-lang []
  (let [new-lang ({:en :uk :uk :en} @lang)]
    (reset! lang new-lang)
    (.setItem js/localStorage
              "lang"
              (name new-lang))))

(defn button-toggle-lang []
 [:button
    {:on-click toggle-lang}
    "🌍 "
    (t :topb/lang)])
