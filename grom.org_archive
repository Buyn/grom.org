```clojure
(defn conference-card [conf]
  [:div
   {:class "bg-white rounded-xl shadow-lg overflow-hidden"}

   [:div {:class "p-8"}

    [:div
     {:class "text-sm uppercase tracking-wide text-ueava-brown-700 mb-2"}
     (str (:city conf) " • " (:year conf))]

    [:h3
     {:class "text-2xl font-bold mb-4"}
     (if (= @lang :uk)
       (:title-uk conf)
       (:title-en conf))]

    [:p
     {:class "text-gray-700 leading-relaxed mb-6"}
     (if (= @lang :uk)
       (:text-uk conf)
       (:text-en conf))]

    [:div {:class "flex flex-wrap gap-4"}

     [:a
      {:href (:pdf conf)
       :target "_blank"
       :class "px-5 py-2 rounded-lg bg-ueava-brown-900 text-white hover:opacity-90"}
      (if (= @lang :uk)
        "Звіт PDF"
        "PDF Report")]

     [:a
      {:href (:photos conf)
       :target "_blank"
       :class "px-5 py-2 rounded-lg border border-ueava-brown-900 text-ueava-brown-900 hover:bg-ueava-brown-50"}
      (if (= @lang :uk)
        "Фотоархів"
        "Photo Archive")]]]])
```

